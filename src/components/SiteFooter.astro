---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <hr class="hairline" />
  <div class="wrap inner">
    <p class="annotation tagline">20 years as the end user.</p>
    <nav class="links" aria-label="Elsewhere">
      <a href="https://x.com/stevekim_ai" rel="me">X</a>
      <a href="https://www.youtube.com/@stevekim_ai" rel="me">YouTube</a>
      <a href="/rss.xml">RSS</a>
    </nav>
    <p class="annotation copy">© {year} Steve Kim · Seoul → Global</p>
  </div>
</footer>
<style>
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem 1.5rem;
    padding-block: 2rem 3rem;
  }
  .tagline { color: var(--paper); }
  .links { display: flex; gap: 1.2rem; }
  .links a {
    font-family: var(--font-annotation);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.72rem;
    color: var(--paper-dim);
    border: none;
  }
  .links a:hover { color: var(--isotope); }
  .copy { width: 100%; }
</style>
